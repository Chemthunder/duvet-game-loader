ilder {\r\n            this.app.createFile(operation);\r\n            return this;\r\n        }\r\n\r\n        public store(fileLocation: string, data: any): ApplicationBuilder {\r\n            this.app.store(fileLocation, data);\r\n            return this;\r\n        }\r\n\r\n        public build(): Application {\r\n            const built = new Application(this.name);\r\n\r\n            built.c\r\n        }\r\n    }\r\n}\r\n\r\nmodule BasicSim {\r\n    export const Cursor = SpriteKind.create();\r\n    export const ClickableApplication = SpriteKind.create();\r\n\r\n    export const depot = new PipelineDepo();\r\n\r\n    export class Primary implements Pipeline {\r\n        Begin: Payload = new Payload();\r\n\r\n        public constructor() { }\r\n\r\n        public assemble() {\r\n            this.Begin.attach(() => { // Primary script\r\n                enablePrint();\r\n\r\n                print(\"Started.\");\r\n\r\n                const CURSOR = new Builders.SpriteBuilder()\r\n                    .withKind(Cursor)\r\n                    .withImage(createImage(6, 6, game.Color.Yellow))\r\n                    .withMoveSpeed(150, 150)\r\n                    .withPosition(screen.width / 2, screen.height / 2)\r\n                    .build();\r\n            });\r\n        }\r\n\r\n        public getPayloads(): Payload[] {\r\n            return [\r\n                this.Begin\r\n            ];\r\n        }\r\n\r\n        public getId(): string {\r\n            return \"Primary\"\r\n        }\r\n    }\r\n\r\n    depot.loadSingular(new Primary());\r\n    depot.bootstrap();\r\n}","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"Coil\": \"github:chemthunder/coil#3e35a246631fc8c3d1c77b18457cf3f62c9f468b\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\"\n}\n"}},{"timestamp":1783952680186,"editorVersion":"4.0.14","text":{"main.ts":"module Duvet.API {\r\n    export const carts: CartridgeSprite[] = [];\r\n\r\n    export class CartridgeSprite extends Sprite {\r\n        public packet: Payload = new Payload();\r\n        public recordedData: DataCompound;\r\n\r\n        public constructor(\r\n            public name: string\r\n        ) {\r\n            super(createImage(0, 0));\r\n            this.recordedData = new DataCompound(this.name);\r\n        }\r\n\r\n        public createFile(operation: () => void) {\r\n            this.packet.attach(operation);\r\n        }\r\n\r\n        public store(fileLocation: string, data: any) {\r\n            this.recordedData.write(fileLocation, data);\r\n        }\r\n\r\n        public read(fileLocation: string): any {\r\n            return this.recordedData.read(fileLocation)\r\n        }\r\n\r\n        public open() {\r\n            this.packet.deploy();\r\n        }\r\n\r\n        public build() {\r\n            carts.push(this);\r\n\r\n            Dispatcher.fetchScene().physicsEngine.addSprite(this);\r\n        }\r\n    }\r\n\r\n    export class CartBuilder {\r\n        public operations: Runnable[];\r\n\r\n        public constructor(\r\n            public name: string\r\n        ) {\r\n            this.operations = [];\r\n        }\r\n\r\n        public file(operation: () => void): CartBuilder {\r\n            this.operations.push(new Runnable(operation));\r\n            return this;\r\n        }\r\n\r\n        public build(): CartridgeSprite {\r\n            const built = new CartridgeSprite(this.name);\r\n            for (let op of this.operations) {\r\n                built.createFile(() => op.run());\r\n            }\r\n            built.build();\r\n            return built;\r\n        }\r\n    }\r\n}\r\n\r\nmodule Duvet.Carts {\r\n    export const TestApp: API.CartridgeSprite = new API.CartBuilder(\"TestApp\")\r\n        .file(() => {\r\n            print(\"Hi\");\r\n        })\r\n        .file(() => {\r\n            print(\"Hello!\");\r\n        })\r\n        .build();\r\n\r\n    export const SecondApp: API.CartridgeSprite = new API.CartBuilder(\"SecondApp\")\r\n        .file(() => {\r\n            print(\"Other app\");\r\n        })\r\n        .build();\r\n}\r\n\r\nmodule Duvet {\r\n    export const Clickable = SpriteKind.create();\r\n\r\n    export const depot = new PipelineDepo();\r\n\r\n    export class Primary implements Pipeline {\r\n        Begin: Payload = new Payload();\r\n\r\n        public index: number = 0;\r\n\r\n        public constructor() { }\r\n\r\n        public assemble() {\r\n            this.Begin.attach(() => { // Primary script\r\n                enablePrint();\r\n\r\n                for (let appl of API.carts) {\r\n                    print(\"Loaded\", appl.name);\r\n                }\r\n\r\n                controller.right.onEvent(ControllerButtonEvent.Pressed, () => {\r\n                    if (this.index < API.carts.length - 1) {\r\n                        this.index++;\r\n                    } else {\r\n                        this.index = 0;\r\n                    }\r\n\r\n                    this.update();\r\n                });\r\n            });\r\n        }\r\n\r\n        public update() {\r\n            const toDraw = API.carts.get(this.index);\r\n\r\n\r\n        }\r\n\r\n        public getPayloads(): Payload[] {\r\n            return [\r\n                this.Begin\r\n            ];\r\n        }\r\n\r\n        public getId(): string {\r\n            return \"Primary\"\r\n        }\r\n    }\r\n\r\n    depot.loadSingular(new Primary());\r\n    depot.bootstrap();\r\n}","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Duvet Game Loader\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"Coil\": \"github:chemthunder/coil#3e35a246631fc8c3d1c77b18457cf3f62c9f468b\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\"\n}\n"}}],"shares":[],"lastSaveTime":1783953244920}